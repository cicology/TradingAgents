# Copy to .env in this folder. Never commit .env.
# Revoke any key that was pasted into chat before using it here.

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
DESK_SITE_URL=https://localhost
DESK_SITE_NAME=Oryares Desk

# Kos-M/binance SDK (optional). Public ping/klines need no keys.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
# Live market orders stay blocked unless this is exactly 1
DESK_ALLOW_LIVE_ORDERS=0

# Kelly sizing: half-Kelly (0.5) and a 5% hard cap. Never use full Kelly in live.
KELLY_FRACTION=0.5
KELLY_CAP=0.05

# MetaTrader 5 — terminal must be open and logged in. Algo Trading enabled for live.
# MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_SYMBOL_GOLD=XAUUSD
MT5_SYMBOL_SILVER=XAGUSD
MT5_SYMBOL_US500=US500
MT5_SYMBOL_NAS100=NAS100
MT5_SYMBOL_BTC=BTCUSD
MT5_SYMBOL_ETH=ETHUSD
MT5_MAX_DAILY_LOSS_PCT=3
MT5_DEVIATION=30
